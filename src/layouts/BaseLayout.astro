---
import '../styles/global.css';
import CampAuth from '../components/CampAuth.astro';
import { AUTH_KEY, AUTH_VALUE } from '../lib/camp-auth';
import { href, stripBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  mode?: 'public' | 'intern';
  showLogout?: boolean;
  gate?: boolean;
}

const {
  title,
  description = 'OTTV Trainingslager Tianjin 2026 — Tagebuch und Camp-Infos.',
  mode = 'public',
  showLogout = mode === 'intern',
  gate = false,
} = Astro.props;

const pageTitle = title === 'OTTV Tianjin 2026' ? title : `${title} · OTTV Tianjin 2026`;
const path = stripBase(Astro.url.pathname);
const loginUrl = href('/intern/login');
---

<!doctype html>
<html lang="de" class:list={[gate && 'camp-gate']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5b3d9a" />
    <link rel="icon" type="image/png" href={href('/images/ottv-logo.png')} />
    <link rel="apple-touch-icon" href={href('/images/ottv-logo.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MZH4LT7BNR"></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', 'G-MZH4LT7BNR');
          </script>
        </>
      )
    }
    {
      gate && (
        <>
          <style is:inline>
            html.camp-gate:not(.camp-ready) body {
              visibility: hidden;
            }
          </style>
          <script is:inline define:vars={{ loginUrl, AUTH_KEY, AUTH_VALUE }}>
            try {
              if (localStorage.getItem(AUTH_KEY) === AUTH_VALUE) {
                document.documentElement.classList.add('camp-ready');
              } else {
                const next = encodeURIComponent(location.pathname + location.search);
                location.replace(loginUrl + '?next=' + next);
              }
            } catch (e) {
              location.replace(loginUrl);
            }
          </script>
        </>
      )
    }
  </head>
  <body data-mode={mode}>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={href('/')}>
          <img
            class="brand__logo"
            src={href('/images/ottv-logo.png')}
            alt="OTTV — Ostschweizer Tischtennisverband"
            width="800"
            height="375"
          />
          <span class="brand__text">
            <span class="brand__name">Tianjin 2026</span>
            <span class="brand__sub">Trainingslager · China</span>
          </span>
        </a>

        <details class="nav-drawer">
          <summary class="nav-drawer__toggle" aria-label="Menü öffnen">
            <span class="nav-drawer__bars" aria-hidden="true"></span>
          </summary>
          <nav class="nav" aria-label="Hauptnavigation">
            <a href={href('/')} aria-current={path === '/' ? 'page' : undefined}>Start</a>
            <a href={href('/blog')} aria-current={path.startsWith('/blog') ? 'page' : undefined}>Tagebuch</a>
            <a href={href('/lager')} aria-current={path.startsWith('/lager') ? 'page' : undefined}>Lager</a>
            {
              mode !== 'intern' && (
                <a class="nav-camp" href={href('/intern')}>
                  Lagerteilnehmer
                </a>
              )
            }
          </nav>
        </details>

        <nav class="nav nav--desktop" aria-label="Hauptnavigation">
          <a href={href('/')} aria-current={path === '/' ? 'page' : undefined}>Start</a>
          <a href={href('/blog')} aria-current={path.startsWith('/blog') ? 'page' : undefined}>Tagebuch</a>
          <a href={href('/lager')} aria-current={path.startsWith('/lager') ? 'page' : undefined}>Lager</a>
          {
            mode !== 'intern' && (
              <a class="nav-camp" href={href('/intern')}>
                Lagerteilnehmer
              </a>
            )
          }
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p>OTTV Tianjin 2026 · Training mit Ma Wenge</p>
        <p>
          {
            showLogout ? (
              <button class="btn btn-ghost" type="button" data-camp-logout style="min-height:2.75rem;padding:0.45rem 1rem;font-size:0.95rem">
                Abmelden
              </button>
            ) : (
              <a href={href('/intern')}>Camp-Bereich</a>
            )
          }
        </p>
      </div>
    </footer>
    <CampAuth />
    {
      import.meta.env.PROD && (
        <script is:inline>
          (function () {
            if (typeof gtag !== 'function') return;

            function mediaLabel(url) {
              if (!url) return '';
              try {
                var path = new URL(url, location.href).pathname;
                var parts = path.split('/').filter(Boolean);
                var upload = parts.indexOf('upload');
                if (upload >= 0) {
                  var after = parts.slice(upload + 1).filter(function (p) {
                    return !/^(v\d+|f_|q_|c_|w_|h_|g_)/.test(p);
                  });
                  return after.join('/').replace(/\.[a-z0-9]+$/i, '');
                }
                return parts[parts.length - 1] || url;
              } catch (e) {
                return url;
              }
            }

            function track(name, params) {
              gtag('event', name, Object.assign({ page_path: location.pathname }, params));
            }

            var main = document.getElementById('main-content');
            if (!main) return;

            main.addEventListener('click', function (event) {
              var target = event.target;
              if (!(target instanceof Element)) return;
              var img = target.closest('img');
              if (!img || !main.contains(img)) return;
              if (img.closest('a.brand, .site-header, .site-footer')) return;
              track('image_click', {
                media_id: mediaLabel(img.currentSrc || img.src),
                image_alt: (img.getAttribute('alt') || '').slice(0, 100),
              });
            });

            main.querySelectorAll('video').forEach(function (video) {
              if (video.dataset.gaBound) return;
              video.dataset.gaBound = '1';
              var milestones = { 25: false, 50: false, 75: false };

              video.addEventListener('play', function () {
                track('video_play', {
                  media_id: mediaLabel(video.currentSrc || video.src),
                  video_current_time: Math.round(video.currentTime),
                });
              });

              video.addEventListener('pause', function () {
                if (video.ended) return;
                track('video_pause', {
                  media_id: mediaLabel(video.currentSrc || video.src),
                  video_current_time: Math.round(video.currentTime),
                  video_percent: video.duration
                    ? Math.round((video.currentTime / video.duration) * 100)
                    : 0,
                });
              });

              video.addEventListener('ended', function () {
                track('video_complete', {
                  media_id: mediaLabel(video.currentSrc || video.src),
                });
              });

              video.addEventListener('timeupdate', function () {
                if (!video.duration) return;
                var pct = (video.currentTime / video.duration) * 100;
                [25, 50, 75].forEach(function (mark) {
                  if (pct >= mark && !milestones[mark]) {
                    milestones[mark] = true;
                    track('video_progress', {
                      media_id: mediaLabel(video.currentSrc || video.src),
                      video_percent: mark,
                    });
                  }
                });
              });
            });
          })();
        </script>
      )
    }
    <script>
      const drawer = document.querySelector('.nav-drawer');
      const toggle = document.querySelector('.nav-drawer__toggle');

      function syncMenuLabel() {
        if (!(drawer instanceof HTMLDetailsElement) || !(toggle instanceof HTMLElement)) return;
        toggle.setAttribute('aria-label', drawer.open ? 'Menü schliessen' : 'Menü öffnen');
        toggle.setAttribute('aria-expanded', drawer.open ? 'true' : 'false');
      }

      if (drawer instanceof HTMLDetailsElement) {
        syncMenuLabel();
        drawer.addEventListener('toggle', syncMenuLabel);
      }

      document.querySelectorAll('.nav-drawer .nav a').forEach((link) => {
        link.addEventListener('click', () => {
          if (drawer instanceof HTMLDetailsElement) drawer.open = false;
        });
      });
    </script>
  </body>
</html>
