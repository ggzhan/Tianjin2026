---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { href } from '../../lib/paths';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && !data.placeholder);
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect(href('/blog'));
}

const post = await getEntry('blog', slug);
if (!post || post.data.draft || post.data.placeholder) {
  return Astro.redirect(href('/404'));
}

const { Content } = await render(post);
const isGallery = post.data.gallery;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class:list={['section', 'diary-post', isGallery && 'diary-post--gallery']}>
    <div class="wrap diary-post__inner">
      <p class="eyebrow">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('de-CH', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
        </time>
        {' · '}
        {post.data.author}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
    </div>

    {
      post.data.cover && (
        <div class="diary-post__cover wrap">
          <img
            src={post.data.cover.startsWith('http') ? post.data.cover : href(post.data.cover)}
            alt={post.data.coverAlt || ''}
            width="1600"
            height="900"
            fetchpriority="high"
          />
        </div>
      )
    }

    <div class:list={['wrap', 'prose', isGallery ? 'diary-post__gallery' : 'diary-post__inner']} style="margin-top: 2rem">
      <Content />
      <p style="margin-top: 2.5rem">
        <a href={href('/blog')}>← Zum Tagebuch</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .diary-post__inner {
    width: min(100% - 2rem, 42rem);
  }

  .diary-post__gallery {
    width: min(100% - 1.5rem, 64rem);
  }

  .diary-post__cover {
    width: min(100% - 2rem, 52rem);
    margin-top: 1.5rem;
  }

  .diary-post--gallery .diary-post__cover {
    width: min(100% - 1.5rem, 64rem);
  }

  .diary-post__cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  .diary-post :global(.prose img),
  .diary-post :global(.prose video) {
    width: 100%;
    border-radius: 0.65rem;
    margin: 1.25rem 0;
  }

  .diary-post :global(.prose video) {
    aspect-ratio: 16 / 9;
    background: var(--ink);
    display: block;
  }

  .diary-post :global(.gallery) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 1.35rem 0 1.75rem;
  }

  @media (min-width: 720px) {
    .diary-post :global(.gallery) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }

  .diary-post :global(.gallery figure) {
    margin: 0;
    border-radius: 0.55rem;
    overflow: hidden;
    background: var(--surface);
  }

  .diary-post :global(.gallery img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }

  .diary-post :global(.gallery figure.span-2) {
    grid-column: span 2;
  }

  .diary-post :global(.gallery figure.span-2 img) {
    aspect-ratio: 16 / 10;
  }

  .diary-post :global(.gallery-caption) {
    margin: -0.75rem 0 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .diary-post :global(.video-stack) {
    display: grid;
    gap: 1rem;
    margin: 1.35rem 0 1.75rem;
  }

  @media (min-width: 860px) {
    .diary-post :global(.video-stack) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .diary-post :global(.video-stack video) {
    margin: 0;
    width: 100%;
    max-height: 34rem;
    height: auto;
    object-fit: contain;
    background: var(--ink);
    justify-self: center;
  }

  @media (min-width: 860px) {
    .diary-post :global(.video-stack video) {
      max-height: 28rem;
    }
  }
</style>
