# Shared password for the /intern area.
# Locally: copy to .env
# GitHub Pages: add repository secret CAMP_PASSWORD (Settings → Secrets → Actions)
CAMP_PASSWORD=change-me

# Cloudflare R2 (media hosting)
# Dashboard: R2 → Manage R2 API Tokens → Create API token
# Public URL: bucket → Settings → Public access → enable r2.dev
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=tianjin2026-media
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Optional: override media base at build time (see src/lib/media.ts)
# PUBLIC_MEDIA_BASE=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
